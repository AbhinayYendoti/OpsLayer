# ============================================================
# Libra AI Coworker Demo — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it's in .gitignore

# OpenAI API Key (required)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model Selection
# Options: gpt-4o, gpt-4o-mini (cheaper/faster for dev)
OPENAI_MODEL=gpt-4o-mini

# App Configuration
LIBRA_ENV=development        # development | production
LIBRA_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR

# Safety Configuration
REQUIRE_APPROVAL_FOR_WRITES=true   # Always keep this true

# ============================================================
# Future API Keys (not used in v1 — placeholders for real APIs)
# ============================================================
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# HUBSPOT_API_KEY=
# SALESFORCE_CLIENT_ID=
